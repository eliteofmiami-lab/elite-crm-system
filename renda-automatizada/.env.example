# Copie este arquivo para .env e preencha. NUNCA commite o .env (já está no .gitignore).
#   cp renda-automatizada/.env.example renda-automatizada/.env

# --- YouTube Data API v3 (gratuita; 10.000 unidades/dia por projeto) ---
# Como obter: research/GUIA_YOUTUBE_API.md
YOUTUBE_API_KEY=

# Limite diário que o cliente respeita (parar antes de estourar a quota do Google)
YOUTUBE_DAILY_BUDGET_UNITS=9000
